rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================
    // Primitive Helpers (Phase 3)
    // =========================================================
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'israrwazeer89@gmail.com'
      );
    }

    function isValidShortString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidStringArray(arr, maxItems) {
      return arr is list && arr.size() <= maxItems && (arr.size() == 0 || (arr[0] is string && arr[0].size() >= 1 && arr[0].size() <= 60));
    }

    // =========================================================
    // Validation Blueprints (Phase 4)
    // =========================================================
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
        'uid', 'displayName', 'photoURL', 'country', 'bio',
        'teachSkills', 'learnSkills', 'experienceLevel', 'languages',
        'availability', 'ratingAvg', 'ratingCount', 'completedExchanges',
        'isVerified', 'isSuspended', 'isPublic', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid', 'displayName', 'photoURL', 'country', 'bio',
        'teachSkills', 'learnSkills', 'experienceLevel', 'languages',
        'availability', 'ratingAvg', 'ratingCount', 'completedExchanges',
        'isVerified', 'isSuspended', 'isPublic', 'createdAt', 'updatedAt'
      ]) &&
      data.uid == userId &&
      isValidId(data.uid) &&
      isValidShortString(data.displayName, 2, 80) &&
      isValidShortString(data.photoURL, 0, 1000) &&
      isValidShortString(data.country, 2, 80) &&
      isValidShortString(data.bio, 0, 600) &&
      isValidStringArray(data.teachSkills, 15) &&
      isValidStringArray(data.learnSkills, 15) &&
      data.experienceLevel in ['Beginner', 'Intermediate', 'Advanced', 'Expert'] &&
      isValidStringArray(data.languages, 10) &&
      isValidShortString(data.availability, 0, 120) &&
      (data.ratingAvg is number && data.ratingAvg >= 0 && data.ratingAvg <= 5) &&
      (data.ratingCount is int && data.ratingCount >= 0 && data.ratingCount <= 100000) &&
      (data.completedExchanges is int && data.completedExchanges >= 0 && data.completedExchanges <= 100000) &&
      data.isVerified is bool &&
      data.isSuspended is bool &&
      data.isPublic is bool &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'blockedUserIds', 'allowMessagesFrom', 'emailNotifications', 'updatedAt']) &&
      data.keys().hasOnly(['uid', 'email', 'blockedUserIds', 'allowMessagesFrom', 'emailNotifications', 'updatedAt']) &&
      data.uid == userId &&
      isValidId(data.uid) &&
      isValidShortString(data.email, 0, 160) &&
      isValidStringArray(data.blockedUserIds, 100) &&
      data.allowMessagesFrom in ['anyone', 'matched_only'] &&
      data.emailNotifications is bool &&
      data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data, userId) {
      return data.keys().hasAll(['uid', 'role', 'createdAt']) &&
      data.keys().hasOnly(['uid', 'role', 'createdAt']) &&
      data.uid == userId &&
      isValidId(data.uid) &&
      data.role in ['admin', 'superadmin'] &&
      data.createdAt is timestamp;
    }

    function isValidSkill(data, skillId) {
      return data.keys().hasAll(['id', 'name', 'category', 'description', 'createdBy', 'isActive', 'createdAt', 'updatedAt']) &&
      data.keys().hasOnly(['id', 'name', 'category', 'description', 'createdBy', 'isActive', 'createdAt', 'updatedAt']) &&
      data.id == skillId &&
      isValidId(data.id) &&
      isValidShortString(data.name, 2, 60) &&
      isValidShortString(data.category, 2, 50) &&
      isValidShortString(data.description, 0, 300) &&
      isValidId(data.createdBy) &&
      data.isActive is bool &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidExchangeRequest(data, requestId) {
      return data.keys().hasAll([
        'id', 'fromUid', 'toUid', 'fromName', 'toName', 'participants',
        'offeredSkill', 'requestedSkill', 'message', 'scheduleNote', 'status', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'fromUid', 'toUid', 'fromName', 'toName', 'participants',
        'offeredSkill', 'requestedSkill', 'message', 'scheduleNote', 'status', 'createdAt', 'updatedAt'
      ]) &&
      data.id == requestId &&
      isValidId(data.id) &&
      isValidId(data.fromUid) &&
      isValidId(data.toUid) &&
      data.fromUid != data.toUid &&
      isValidShortString(data.fromName, 1, 80) &&
      isValidShortString(data.toName, 1, 80) &&
      data.participants is list &&
      data.participants.size() == 2 &&
      data.participants.hasAll([data.fromUid, data.toUid]) &&
      isValidShortString(data.offeredSkill, 1, 60) &&
      isValidShortString(data.requestedSkill, 1, 60) &&
      isValidShortString(data.message, 0, 800) &&
      isValidShortString(data.scheduleNote, 0, 200) &&
      data.status in ['pending', 'accepted', 'rejected', 'completed', 'cancelled'] &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidAiMatch(data, matchId) {
      return data.keys().hasAll([
        'id', 'userId', 'partnerId', 'partnerName', 'compatibilityScore',
        'reason', 'primarySwap', 'isAlternative', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'userId', 'partnerId', 'partnerName', 'compatibilityScore',
        'reason', 'primarySwap', 'isAlternative', 'createdAt'
      ]) &&
      data.id == matchId &&
      isValidId(data.id) &&
      isValidId(data.userId) &&
      isValidId(data.partnerId) &&
      data.userId != data.partnerId &&
      isValidShortString(data.partnerName, 1, 80) &&
      (data.compatibilityScore is int && data.compatibilityScore >= 0 && data.compatibilityScore <= 100) &&
      isValidShortString(data.reason, 5, 600) &&
      isValidShortString(data.primarySwap, 1, 140) &&
      data.isAlternative is bool &&
      data.createdAt is timestamp;
    }

    function isValidConversation(data, conversationId) {
      return data.keys().hasAll([
        'id', 'participantIds', 'participantNames', 'participantPhotos',
        'exchangeRequestId', 'lastMessage', 'lastSenderId', 'unreadBy',
        'lastMessageAt', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'participantIds', 'participantNames', 'participantPhotos',
        'exchangeRequestId', 'lastMessage', 'lastSenderId', 'unreadBy',
        'lastMessageAt', 'createdAt', 'updatedAt'
      ]) &&
      data.id == conversationId &&
      isValidId(data.id) &&
      data.participantIds is list &&
      data.participantIds.size() == 2 &&
      isValidId(data.participantIds[0]) &&
      isValidId(data.participantIds[1]) &&
      data.participantIds[0] != data.participantIds[1] &&
      data.participantNames is map &&
      data.participantNames.keys().hasAll(data.participantIds) &&
      data.participantNames.keys().hasOnly(data.participantIds) &&
      data.participantPhotos is map &&
      data.participantPhotos.keys().hasOnly(data.participantIds) &&
      isValidShortString(data.exchangeRequestId, 0, 128) &&
      isValidShortString(data.lastMessage, 0, 500) &&
      isValidShortString(data.lastSenderId, 0, 128) &&
      data.unreadBy is list &&
      data.unreadBy.size() <= 2 &&
      data.lastMessageAt is timestamp &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidChatMessage(data, conversationId, messageId) {
      return data.keys().hasAll(['id', 'conversationId', 'participantIds', 'senderId', 'senderName', 'text', 'createdAt']) &&
      data.keys().hasOnly(['id', 'conversationId', 'participantIds', 'senderId', 'senderName', 'text', 'createdAt']) &&
      data.id == messageId &&
      data.conversationId == conversationId &&
      isValidId(data.id) &&
      isValidId(data.conversationId) &&
      data.participantIds is list &&
      data.participantIds.size() == 2 &&
      isValidId(data.senderId) &&
      isValidShortString(data.senderName, 1, 80) &&
      isValidShortString(data.text, 1, 2000) &&
      data.createdAt is timestamp;
    }

    function isValidReview(data, reviewId) {
      return data.keys().hasAll([
        'id', 'exchangeId', 'reviewerId', 'reviewerName', 'revieweeId',
        'rating', 'comment', 'skillLearned', 'isVisible', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'exchangeId', 'reviewerId', 'reviewerName', 'revieweeId',
        'rating', 'comment', 'skillLearned', 'isVisible', 'createdAt'
      ]) &&
      data.id == reviewId &&
      isValidId(data.id) &&
      isValidId(data.exchangeId) &&
      isValidId(data.reviewerId) &&
      isValidId(data.revieweeId) &&
      data.reviewerId != data.revieweeId &&
      isValidShortString(data.reviewerName, 1, 80) &&
      (data.rating is int && data.rating >= 1 && data.rating <= 5) &&
      isValidShortString(data.comment, 3, 800) &&
      isValidShortString(data.skillLearned, 1, 60) &&
      data.isVisible is bool &&
      data.createdAt is timestamp;
    }

    function isValidNotification(data, notificationId) {
      return data.keys().hasAll(['id', 'userId', 'senderId', 'type', 'title', 'body', 'relatedId', 'isRead', 'createdAt']) &&
      data.keys().hasOnly(['id', 'userId', 'senderId', 'type', 'title', 'body', 'relatedId', 'isRead', 'createdAt']) &&
      data.id == notificationId &&
      isValidId(data.id) &&
      isValidId(data.userId) &&
      isValidId(data.senderId) &&
      data.type in ['new_match', 'exchange_request', 'exchange_accepted', 'exchange_completed', 'new_message', 'new_review', 'system'] &&
      isValidShortString(data.title, 1, 120) &&
      isValidShortString(data.body, 1, 300) &&
      isValidShortString(data.relatedId, 0, 128) &&
      data.isRead is bool &&
      data.createdAt is timestamp;
    }

    function isValidReport(data, reportId) {
      return data.keys().hasAll(['id', 'reporterId', 'reportedUid', 'reason', 'details', 'status', 'createdAt', 'updatedAt']) &&
      data.keys().hasOnly(['id', 'reporterId', 'reportedUid', 'reason', 'details', 'status', 'createdAt', 'updatedAt']) &&
      data.id == reportId &&
      isValidId(data.id) &&
      isValidId(data.reporterId) &&
      isValidId(data.reportedUid) &&
      data.reporterId != data.reportedUid &&
      data.reason in ['spam', 'harassment', 'inappropriate_content', 'fake_profile', 'other'] &&
      isValidShortString(data.details, 5, 1000) &&
      data.status in ['open', 'reviewed', 'actioned', 'dismissed'] &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // =========================================================
    // Collection Rules
    // =========================================================

    // 1. Public Peer Profiles (Strictly PII-Free)
    match /users/{userId} {
      allow get: if isValidId(userId) && (
        isOwner(userId) ||
        isAdmin() ||
        (existing().isPublic == true && existing().isSuspended == false)
      );
      allow list: if (
        (existing().isPublic == true && existing().isSuspended == false) ||
        isAdmin()
      );
      allow create: if isValidId(userId) && isVerifiedUser() && isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().isVerified == false &&
        incoming().isSuspended == false &&
        incoming().ratingAvg == 0 &&
        incoming().ratingCount == 0 &&
        incoming().completedExchanges == 0 &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(userId) && isVerifiedUser() &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            isOwner(userId) &&
            existing().isSuspended == false &&
            incoming().isVerified == existing().isVerified &&
            incoming().isSuspended == existing().isSuspended &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'photoURL', 'country', 'bio',
              'teachSkills', 'learnSkills', 'experienceLevel',
              'languages', 'availability', 'isPublic', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(userId) && isAdmin();

      // Strictly Isolated PII Subcollection
      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) || isAdmin();
        allow create: if isValidId(userId) && isValidId(docId) && docId == 'info' &&
          isVerifiedUser() && isOwner(userId) &&
          isValidPrivateInfo(incoming(), userId) &&
          incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(docId) && docId == 'info' &&
          isVerifiedUser() && (isOwner(userId) || isAdmin()) &&
          isValidPrivateInfo(incoming(), userId) &&
          incoming().uid == existing().uid &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'email', 'blockedUserIds', 'allowMessagesFrom', 'emailNotifications', 'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(docId) && isAdmin();
      }
    }

    // 2. Admins
    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isValidId(userId) && isAdmin() &&
        isValidAdminRecord(incoming(), userId) &&
        incoming().createdAt == request.time;
      allow delete: if isValidId(userId) && isAdmin();
    }

    // 3. Skills Catalog
    match /skills/{skillId} {
      allow get: if isValidId(skillId) && (existing().isActive == true || isAdmin());
      allow list: if existing().isActive == true || isAdmin();
      allow create: if isValidId(skillId) && isAdmin() &&
        isValidSkill(incoming(), skillId) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(skillId) && isAdmin() &&
        isValidSkill(incoming(), skillId) &&
        incoming().id == existing().id &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'category', 'description', 'isActive', 'updatedAt']);
      allow delete: if isValidId(skillId) && isAdmin();
    }

    // 4. Exchange Requests
    match /exchangeRequests/{requestId} {
      allow get: if isValidId(requestId) && isSignedIn() && (
        request.auth.uid in existing().participants || isAdmin()
      );
      allow list: if isSignedIn() && (
        request.auth.uid in existing().participants || isAdmin()
      );
      allow create: if isValidId(requestId) && isVerifiedUser() &&
        isValidExchangeRequest(incoming(), requestId) &&
        incoming().fromUid == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/users/$(incoming().toUid));

      allow update: if isValidId(requestId) && isVerifiedUser() &&
        isValidExchangeRequest(incoming(), requestId) &&
        incoming().id == existing().id &&
        incoming().fromUid == existing().fromUid &&
        incoming().toUid == existing().toUid &&
        incoming().participants == existing().participants &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            // Terminal State Locking
            !(existing().status in ['completed', 'rejected', 'cancelled']) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) && (
              // Action: Recipient accepts or rejects pending request
              (
                existing().toUid == request.auth.uid &&
                existing().status == 'pending' &&
                incoming().status in ['accepted', 'rejected']
              ) ||
              // Action: Sender cancels pending request
              (
                existing().fromUid == request.auth.uid &&
                existing().status == 'pending' &&
                incoming().status == 'cancelled'
              ) ||
              // Action: Either participant marks accepted exchange as completed
              (
                request.auth.uid in existing().participants &&
                existing().status == 'accepted' &&
                incoming().status == 'completed'
              )
            )
          )
        );
      allow delete: if isValidId(requestId) && isAdmin();
    }

    // 5. AI Matches
    match /matches/{matchId} {
      allow get: if isValidId(matchId) && isSignedIn() && (
        existing().userId == request.auth.uid || isAdmin()
      );
      allow list: if isSignedIn() && (
        existing().userId == request.auth.uid || isAdmin()
      );
      allow create: if isValidId(matchId) && isVerifiedUser() &&
        isValidAiMatch(incoming(), matchId) &&
        incoming().userId == request.auth.uid &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/users/$(incoming().partnerId));
      allow update: if isValidId(matchId) && isVerifiedUser() &&
        isValidAiMatch(incoming(), matchId) &&
        incoming().userId == request.auth.uid &&
        incoming().userId == existing().userId &&
        incoming().partnerId == existing().partnerId &&
        incoming().createdAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'partnerName', 'compatibilityScore', 'reason', 'primarySwap', 'isAlternative', 'createdAt'
        ]);
      allow delete: if isValidId(matchId) && isVerifiedUser() && (
        existing().userId == request.auth.uid || isAdmin()
      );
    }

    // 6. Conversations & Messages
    match /conversations/{conversationId} {
      allow get: if isValidId(conversationId) && isSignedIn() && (
        request.auth.uid in existing().participantIds || isAdmin()
      );
      allow list: if isSignedIn() && (
        request.auth.uid in existing().participantIds || isAdmin()
      );
      allow create: if isValidId(conversationId) && isVerifiedUser() &&
        isValidConversation(incoming(), conversationId) &&
        request.auth.uid in incoming().participantIds &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        incoming().lastMessageAt == request.time &&
        exists(/databases/$(database)/documents/users/$(incoming().participantIds[0])) &&
        exists(/databases/$(database)/documents/users/$(incoming().participantIds[1]));

      allow update: if isValidId(conversationId) && isVerifiedUser() &&
        isValidConversation(incoming(), conversationId) &&
        incoming().id == existing().id &&
        incoming().participantIds == existing().participantIds &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            request.auth.uid in existing().participantIds &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'lastMessage', 'lastSenderId', 'unreadBy', 'lastMessageAt', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(conversationId) && isAdmin();

      // Messages Subcollection (Master Gate on parent conversation)
      match /messages/{messageId} {
        allow get: if isValidId(conversationId) && isValidId(messageId) && isSignedIn() && (
          isAdmin() ||
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
        );
        allow list: if isSignedIn() && (
          request.auth.uid in existing().participantIds || isAdmin()
        );
        allow create: if isValidId(conversationId) && isValidId(messageId) && isVerifiedUser() &&
          isValidChatMessage(incoming(), conversationId, messageId) &&
          incoming().senderId == request.auth.uid &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds &&
          incoming().participantIds == get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow update: if false;
        allow delete: if isValidId(conversationId) && isValidId(messageId) && isAdmin();
      }
    }

    // 7. Reviews
    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId) && (existing().isVisible == true || isAdmin());
      allow list: if existing().isVisible == true || isAdmin();
      allow create: if isValidId(reviewId) && isVerifiedUser() &&
        isValidReview(incoming(), reviewId) &&
        incoming().reviewerId == request.auth.uid &&
        incoming().isVisible == true &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/exchangeRequests/$(incoming().exchangeId)) &&
        get(/databases/$(database)/documents/exchangeRequests/$(incoming().exchangeId)).data.status == 'completed' &&
        request.auth.uid in get(/databases/$(database)/documents/exchangeRequests/$(incoming().exchangeId)).data.participants &&
        incoming().revieweeId in get(/databases/$(database)/documents/exchangeRequests/$(incoming().exchangeId)).data.participants;
      allow update: if isValidId(reviewId) && isAdmin() &&
        isValidReview(incoming(), reviewId) &&
        incoming().id == existing().id &&
        incoming().exchangeId == existing().exchangeId &&
        incoming().reviewerId == existing().reviewerId &&
        incoming().revieweeId == existing().revieweeId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['isVisible']);
      allow delete: if isValidId(reviewId) && isAdmin();
    }

    // 8. Notifications
    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && isSignedIn() && (
        existing().userId == request.auth.uid || isAdmin()
      );
      allow list: if isSignedIn() && (
        existing().userId == request.auth.uid || isAdmin()
      );
      allow create: if isValidId(notificationId) && isVerifiedUser() &&
        isValidNotification(incoming(), notificationId) &&
        incoming().senderId == request.auth.uid &&
        incoming().isRead == false &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/users/$(incoming().userId));
      allow update: if isValidId(notificationId) && isVerifiedUser() &&
        isValidNotification(incoming(), notificationId) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        incoming().senderId == existing().senderId &&
        incoming().createdAt == existing().createdAt && (
          isAdmin() ||
          (
            existing().userId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['isRead'])
          )
        );
      allow delete: if isValidId(notificationId) && isVerifiedUser() && (
        existing().userId == request.auth.uid || isAdmin()
      );
    }

    // 9. Trust & Safety Reports
    match /reports/{reportId} {
      allow get: if isValidId(reportId) && isSignedIn() && (
        existing().reporterId == request.auth.uid || isAdmin()
      );
      allow list: if isSignedIn() && (
        existing().reporterId == request.auth.uid || isAdmin()
      );
      allow create: if isValidId(reportId) && isVerifiedUser() &&
        isValidReport(incoming(), reportId) &&
        incoming().reporterId == request.auth.uid &&
        incoming().status == 'open' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/users/$(incoming().reportedUid));
      allow update: if isValidId(reportId) && isAdmin() &&
        isValidReport(incoming(), reportId) &&
        incoming().id == existing().id &&
        incoming().reporterId == existing().reporterId &&
        incoming().reportedUid == existing().reportedUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isValidId(reportId) && isAdmin();
    }
  }
}
